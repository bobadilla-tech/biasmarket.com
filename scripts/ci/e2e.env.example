WEB_URL=http://localhost:3001
INTERNAL_JOBS_SECRET=e2e-internal-jobs-secret
MONITORING_WEBHOOK_SECRET=e2e-monitoring-webhook-secret
SITEMAP_INTERNAL_TOKEN=e2e-sitemap-internal-token
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=e2e
S3_SECRET_KEY=e2e-secret-key
S3_BUCKET=products
S3_LOGO_BUCKET=logos
S3_PAYMENT_BUCKET=payments
