REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BETTER_AUTH_URL=http://localhost:3000
