generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String?
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          String    @default("seller")
  locale        String    @default("es")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  plan          String    @default("basic")
  premiumUntil  DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  sessions          Session[]
  accounts          Account[]
  stores            Store[]
  createdCoupons    Coupon[]           @relation("CouponCreatedBy")
  couponRedemptions CouponRedemption[]

  @@map("user")
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  description  String    @default("")
  plan         String    @default("premium")
  durationDays Int       @default(30)
  maxUses      Int       @default(1)
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  expiresAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy   User?              @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([isActive])
  @@index([plan])
  @@index([code])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  redeemedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
}

model Store {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  locale                String   @default("es")
  ownerId               String
  themeConfig           Json
  logoUrl               String?
  paymentInstructions   String
  whatsappNumber        String?
  instagramUrl          String?
  facebookUrl           String?
  tiktokUrl             String?
  twitterUrl            String?
  defaultCurrency       String   @default("PEN")
  holdWindowHours       Int      @default(48)
  lowStockThreshold     Int      @default(5)
  lowStockAlertsEnabled Boolean  @default(true)
  // Showcased on the public homepage/directory search vs. reachable only by
  // direct link (/store/:slug). Doesn't gate the storefront itself.
  isPublic              Boolean  @default(true)
  createdAt             DateTime @default(now())

  owner             User                      @relation(fields: [ownerId], references: [id])
  products          Product[]
  orders            Order[]
  categories        Category[]
  collections       Collection[]
  sections          StoreSection[]
  customers         Customer[]
  paymentMethods    PaymentMethodConfig[]
  deliveryMethods   DeliveryMethodConfig[]
  pickupPoints      PickupPoint[]
  notifications     Notification[]
  restockRequests   RestockRequest[]
  whatsappTemplates WhatsAppMessageTemplate[]
  buyerLinks        CustomerStoreLink[]

  @@index([ownerId])
  @@index([isPublic, createdAt, id])
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  name           String
  description    String        @default("")
  price          Decimal       @db.Decimal(10, 2)
  currency       String        @default("PEN")
  images         String[]      @default([])
  availableUntil DateTime?
  status         ProductStatus @default(DRAFT)
  soldOut        Boolean       @default(false)
  discontinued   Boolean       @default(false)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())

  store           Store               @relation(fields: [storeId], references: [id])
  variants        ProductVariant[]
  orderItems      OrderItem[]
  categories      ProductCategory[]
  collections     CollectionProduct[]
  restockRequests RestockRequest[]

  @@index([storeId])
  @@index([storeId, status])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  storeId       String
  name          String
  stock         Int?
  reserved      Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2)
  imageOverride String?
  attributes    Json     @default("{}")

  product         Product          @relation(fields: [productId], references: [id])
  orderItems      OrderItem[]
  restockRequests RestockRequest[]

  @@index([productId])
  @@index([storeId])
}

model RestockRequest {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  variantId String?
  name      String
  phone     String
  createdAt DateTime @default(now())

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([productId])
  @@index([variantId])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  parentId  String?
  name      String
  createdAt DateTime @default(now())

  store    Store             @relation(fields: [storeId], references: [id])
  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@unique([storeId, parentId, name])
  @@index([storeId])
  @@index([parentId])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
}

model Collection {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String   @default("")
  createdAt   DateTime @default(now())

  store    Store               @relation(fields: [storeId], references: [id])
  products CollectionProduct[]
  sections StoreSection[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int

  collection Collection @relation(fields: [collectionId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@id([collectionId, productId])
  @@index([productId])
}

enum StoreSectionType {
  COLLECTION
  BANNER
  TEXT_BLOCK
}

model StoreSection {
  id           String           @id @default(cuid())
  storeId      String
  type         StoreSectionType
  collectionId String?
  content      Json             @default("{}")
  position     Int
  hidden       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  store      Store       @relation(fields: [storeId], references: [id])
  collection Collection? @relation(fields: [collectionId], references: [id])

  @@index([storeId])
  @@index([storeId, position])
}

model Order {
  id                     String                  @id @default(cuid())
  storeId                String
  customerId             String?
  // New global buyer identity, added alongside `customerId` rather than
  // replacing it — see docs/plans/2026-08-08-global-buyer-account-plan.md.
  // `customerId` is dropped in a later follow-up migration once the backfill
  // is verified complete.
  buyerAccountId         String?
  customerEmail          String?
  customerPhone          String
  customerName           String?
  deliveryMethodType     DeliveryMethodType
  deliveryDetails        Json
  pickupPointId          String?
  // Set only when the buyer chose a pickup point that isn't open today —
  // the future date they committed to, validated against that point's
  // openDays at checkout. Null for same-day pickup (today is implied).
  pickupDate             DateTime?
  // Buyer's chosen payment method at checkout — optional since older
  // orders (created before this field existed) never captured one.
  paymentMethod          PaymentMethodType?
  paymentStatus          PaymentStatus           @default(PENDING_PAYMENT)
  paymentRejectionReason String?
  fulfillmentStatus      FulfillmentStatus       @default(ORDERING)
  status                 OrderStatus             @default(ACTIVE)
  cancellationResolution CancellationResolution?
  cancellationReason     String?
  retainedAmount         Decimal?                @db.Decimal(10, 2)
  releasedAmount         Decimal?                @db.Decimal(10, 2)
  releasedResolution     CancellationResolution?
  totalAmount            Decimal                 @db.Decimal(10, 2)
  requiredAmount         Decimal                 @db.Decimal(10, 2)
  currency               String
  expiresAt              DateTime
  createdAt              DateTime                @default(now())

  store        Store          @relation(fields: [storeId], references: [id])
  customer     Customer?      @relation(fields: [customerId], references: [id])
  buyerAccount BuyerAccount?  @relation(fields: [buyerAccountId], references: [id])
  pickupPoint  PickupPoint?   @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     OrderPayment[]

  @@index([storeId, paymentStatus])
  @@index([storeId, createdAt])
  @@index([paymentStatus, expiresAt])
  @@index([buyerAccountId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  storeId             String
  productId           String
  variantId           String?
  quantity            Int
  unitPriceAtPurchase Decimal  @db.Decimal(10, 2)
  currency            String
  createdAt           DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([storeId])
}

model OrderPayment {
  id           String              @id @default(cuid())
  orderId      String
  storeId      String
  amount       Decimal             @db.Decimal(10, 2)
  currency     String
  method       PaymentMethodType?
  note         String?
  imageUrl     String?
  createdAt    DateTime            @default(now())
  // Buyer-submitted proof-of-payment upload — see
  // docs/plans/2026-08-08-buyer-proof-of-payment-upload-plan.md. `source`
  // distinguishes who created the row; `reviewStatus` gates whether it
  // counts toward `paidAmount` (see common/payment-summary.ts's
  // `countsTowardPaid` — the single source of truth for this filter, reused
  // by every aggregation call site so this invariant can't drift per-site).
  source       PaymentSource       @default(SELLER_RECORDED)
  reviewStatus PaymentReviewStatus @default(N_A)
  reviewedAt   DateTime?
  reviewedBy   String?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([storeId, createdAt])
}

enum PaymentSource {
  SELLER_RECORDED
  BUYER_SUBMITTED
}

enum PaymentReviewStatus {
  N_A
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAYMENT_SUBMITTED
  VERIFIED
  REJECTED
  CANCELLED
}

enum FulfillmentStatus {
  ORDERING
  IN_TRANSIT
  READY
  COMPLETED
}

enum OrderStatus {
  ACTIVE
  CANCELLED
}

enum ReleaseResolution {
  REFUNDED
  STORE_CREDIT
}

enum CancellationResolution {
  REFUNDED
  RETAINED
  STORE_CREDIT
}

enum DeliveryMethodType {
  PICKUP
  COURIER
}

enum PaymentMethodType {
  YAPE
  PLIN
  TRANSFER
  CASH
}

model PaymentMethodConfig {
  id                    String            @id @default(cuid())
  storeId               String
  method                PaymentMethodType
  enabled               Boolean           @default(true)
  details               Json
  depositPercentPickup  Int               @default(100)
  depositPercentCourier Int               @default(100)
  createdAt             DateTime          @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, method])
  @@index([storeId])
}

model DeliveryMethodConfig {
  id        String             @id @default(cuid())
  storeId   String
  type      DeliveryMethodType
  enabled   Boolean            @default(true)
  details   Json
  createdAt DateTime           @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, type])
  @@index([storeId])
}

enum WhatsAppMessageType {
  NEW_ORDER
  PAYMENT_REMINDER
}

// Per-store override for the WhatsApp message a seller sends to a buyer —
// see docs/plans/2026-08-08-configurable-whatsapp-templates-plan.md. A store
// with no row for a given type falls back to the hardcoded default template
// in packages/utils/src/whatsapp/index.ts.
model WhatsAppMessageTemplate {
  id        String              @id @default(cuid())
  storeId   String
  type      WhatsAppMessageType
  template  String
  updatedAt DateTime            @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, type])
  @@index([storeId])
}

model PickupPoint {
  id             String   @id @default(cuid())
  storeId        String
  label          String
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  // JS Date.getDay() convention: 0=Sunday..6=Saturday. Empty = no
  // restriction / open every day.
  openDays       Int[]    @default([])
  // Manual "not available today/this week" toggle, independent of the
  // weekly openDays schedule and of the permanent `enabled` kill switch.
  closedOverride Boolean  @default(false)
  createdAt      DateTime @default(now())

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@index([storeId])
  @@index([storeId, enabled])
}

model Customer {
  id            String   @id @default(cuid())
  storeId       String
  phone         String
  passwordHash  String?
  email         String?
  emailVerified Boolean  @default(false)
  pendingEmail  String?
  pendingPhone  String?
  name          String?
  createdAt     DateTime @default(now())

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@unique([storeId, phone])
  @@index([storeId])
}

// Global buyer identity — one per phone number across every store, replacing
// per-store `Customer` as the buyer-auth root. See
// docs/plans/2026-08-08-global-buyer-account-plan.md. `Customer` itself is
// kept as a per-store "who has bought here" projection for the seller
// Customers dashboard, decoupled from auth.
model BuyerAccount {
  id              String   @id @default(cuid())
  phone           String   @unique
  passwordHash    String?
  // Bumped (not re-derived from the hash) on every password change and
  // embedded in the session token — the only session-revocation mechanism
  // this stateless-token design has. Replaces the per-Customer
  // hash-derived `derivePasswordVersion` stamp the old guard used.
  passwordVersion Int      @default(0)
  email           String?
  emailVerified   Boolean  @default(false)
  pendingEmail    String?
  pendingPhone    String?
  name            String?
  createdAt       DateTime @default(now())

  stores    CustomerStoreLink[]
  orders    Order[]
  addresses Address[]
}

// Buyer-owned, reusable across every store the BuyerAccount is linked to
// (global identity — see docs/plans/2026-08-08-global-buyer-account-plan.md).
// Not read server-side during checkout; the buyer's default address is only
// ever a client-side prefill, checkout itself accepts inline shippingAddress
// fields — see docs/plans/2026-08-08-buyer-shipping-addresses-plan.md's
// "Important correction" section for why.
model Address {
  id             String   @id @default(cuid())
  buyerAccountId String
  label          String? // "Casa", "Trabajo" — buyer's own name for it
  recipientName  String
  phone          String
  line1          String
  line2          String?
  city           String
  region         String? // department/province, optional — Peru-first, keep loose
  reference      String? // "frente al parque" — very common in LatAm addresses
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Explicit onDelete: Cascade — matches the actually-applied FK from
  // 20260809230000_add_buyer_shipping_addresses (deleting a BuyerAccount
  // should delete their saved addresses with it). Was previously left
  // implicit here, which defaults to RESTRICT and drifted from the real DB
  // constraint — discovered because `prisma migrate dev` for this plan's own
  // migration tried to "fix" the drift by silently flipping the live FK to
  // RESTRICT. Pinned explicitly now so that can't happen again.
  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id], onDelete: Cascade)

  @@index([buyerAccountId])
}

// Join row proving a BuyerAccount has an account/checkout footprint at a
// given store. Created on first successful login/checkout at a new store
// (auto-link, not an opt-in step — see the plan's "API / auth changes").
model CustomerStoreLink {
  id             String   @id @default(cuid())
  buyerAccountId String
  storeId        String
  createdAt      DateTime @default(now())

  buyerAccount BuyerAccount @relation(fields: [buyerAccountId], references: [id])
  store        Store        @relation(fields: [storeId], references: [id])

  @@unique([buyerAccountId, storeId])
  @@index([storeId])
}

enum InquiryStatus {
  NEW
  REVIEWED
  ARCHIVED
}

// Platform-level sales inbox — not tenant data, no storeId by design.
model ContactInquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  company     String?
  inquiryType String?
  message     String
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  PAYMENT_PROOF_SUBMITTED
}

model Notification {
  id         String           @id @default(cuid())
  storeId    String
  type       NotificationType
  entityType String
  entityId   String
  title      String
  body       String           @default("")
  metadata   Json             @default("{}")
  read       Boolean          @default(false)
  readAt     DateTime?
  archived   Boolean          @default(false)
  archivedAt DateTime?
  createdAt  DateTime         @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([storeId, archived, read])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  storeId    String
  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([entityType, entityId])
}

// Platform-level operational data (Uptime Kuma webhook events) — deliberately
// outside the multi-tenancy model, no storeId: an API-down incident isn't
// "owned" by any one store. See docs/plans/2026-08-09-uptime-kuma-monitoring-plan.md.
model PlatformIncident {
  id          String    @id @default(cuid())
  monitorId   Int
  monitorName String
  message     String
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([monitorId, resolvedAt])
}

//BETHER AUTH

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
