{
  "name": "@biasmarket/i18n",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.mobile.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.mobile.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "node ../../scripts/lint-changed-files.mjs packages/i18n && eslint . --max-warnings 0",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^7.0.2",
    "vitest": "4.1.12"
  },
  "exports": {
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "default": "./dist/mobile.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@biasmarket/utils": "workspace:*"
  }
}
