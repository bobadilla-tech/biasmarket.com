# ============================================================================
# infra/vps/env/shared.env — template only, DO NOT populate this file with
# real values and commit it. The real file (env/shared.env, gitignored, see
# ../../.gitignore) lives ONLY on the VPS at /opt/biasmarket/env/shared.env.
#
# ****************************************************************************
# CRITICAL: every secret value in the real env/shared.env must come from the
# reviewed production secret set and must never be committed. In particular
# CUSTOMER_ACCOUNT_TOKEN_SECRET backs a stateless buyer-session HMAC cookie
# with no DB backing (unlike seller sessions, which are better-auth
# DB-backed, see apps/api/src/modules/customer-auth/customer-session.guard.ts)
# — regenerating it instantly logs out every live buyer session, a hard
# cliff, not a gradual expiry.
#
# deploy.sh asserts a sha256 checksum of this file against a known-good
# snapshot (state/shared_env.sha256, recorded once at first bootstrap) on
# EVERY invocation, not just at first cutover, so an accidental future
# regeneration fails the deploy loud instead of silently mass-logging-out
# buyers. See docs/core/blue-green-migrations.md.
# ****************************************************************************
#
# Values below are identical across both colors — the split axis is
# documented in T4 / docs/core/blue-green-migrations.md: only
# INTERNAL_API_URL legitimately differs per color, and it lives in
# env/blue.runtime.env / env/green.runtime.env instead, NOT here.
#
# PORT is also intentionally absent — set directly on each service via
# `environment:` in docker-compose.yml, identical for both colors of a given
# app, no need to route it through an env file at all.
# ============================================================================

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=biasmarket
POSTGRES_PASSWORD=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
POSTGRES_DB=biasmarket
DATABASE_URL=postgresql://biasmarket:REPLACE_WITH_REVIEWED_PRODUCTION_VALUE@db:5432/biasmarket

# ---- Redis (apps/api producer, apps/workers consumer — BullMQ) -----------
REDIS_PASSWORD=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
REDIS_URL=redis://:REPLACE_WITH_REVIEWED_PRODUCTION_VALUE@redis:6379

# ---- apps/api (NestJS + better-auth) --------------------------------------
BETTER_AUTH_URL=https://api.biasmarket.com
BETTER_AUTH_SECRET=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
CUSTOMER_ACCOUNT_TOKEN_SECRET=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
WEB_URL=https://biasmarket.com

# ---- apps/web (Next.js) ----------------------------------------------------
# Baked as a build ARG (see infra/docker/web.Dockerfile) — the same image
# serves both colors since Caddy always terminates api.biasmarket.com
# regardless of which color is live behind it. Present here only because
# some server code paths fall back to it when INTERNAL_API_URL is unset —
# see apps/web/lib/api-client.ts. Not consumed at runtime by anything else.
NEXT_PUBLIC_API_URL=https://api.biasmarket.com

# ---- apps/workers -> apps/api internal endpoints --------------------------
INTERNAL_JOBS_SECRET=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE

# ---- MinIO / S3 -------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://cdn.biasmarket.com
S3_ACCESS_KEY=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
S3_SECRET_KEY=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
S3_BUCKET=products
S3_LOGO_BUCKET=logos
S3_PAYMENT_BUCKET=payments

# ---- apps/workers (mailer / Resend) ----------------------------------------
MAIL_DRIVER=resend
RESEND_API_KEY=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
RESEND_FROM_EMAIL=no-reply@biasmarket.com

# ---- Monitoring (Uptime Kuma -> apps/api durable incident history) --------
MONITORING_WEBHOOK_SECRET=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE
SITEMAP_INTERNAL_TOKEN=REPLACE_WITH_REVIEWED_PRODUCTION_VALUE

# ---- Error tracking (GlitchTip — Sentry-protocol-compatible) --------------
SENTRY_DSN=
WEB_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
