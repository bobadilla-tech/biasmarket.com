# Template only — the real file (env/watchdog.env, gitignored — matches
# infra/vps/env/*.env in ../../.gitignore the same as shared/blue/green)
# lives on the VPS at /opt/biasmarket/env/watchdog.env, read by
# biasmarket-migration-watchdog.service (EnvironmentFile=).
#
# KUMA_MIGRATION_PUSH_URL is the heartbeat URL of the "migration_pending"
# push monitor created by scripts/setup-kuma.ts (Kuma dashboard -> that
# monitor -> copy its push URL, shape:
# https://status.biasmarket.com/api/push/<token>?status=up&msg=OK&ping=).
# Not a value that gets committed — treat it like any other credential.
KUMA_MIGRATION_PUSH_URL=
MIGRATION_WATCHDOG_THRESHOLD_SECONDS=180
