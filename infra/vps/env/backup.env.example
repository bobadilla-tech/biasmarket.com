# Template only. The real file is delivered by Infisical as
# /home/deploy/biasmarket/env/backup.env, owned by root with mode 0600.
# It is read by biasmarket-backup-config.service and the manual backup service.
# Never copy real values into this template, Git, Terraform,
# cloud-init, command-line arguments, or logs.

# Restic encrypts repository contents client-side. Keep this passphrase
# recoverable outside the VPS; 32 or more characters are required.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# Dedicated S3-compatible backup identity, restricted to the configured repo.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Read-only MinIO identity. Source bucket versioning must be enabled before
# running a backup. Grant only GetBucketVersioning, ListBucketVersions, and
# GetObjectVersion on these three source buckets.
BACKUP_SOURCE_ENDPOINT=http://minio:9000
BACKUP_SOURCE_ACCESS_KEY=
BACKUP_SOURCE_SECRET_KEY=

# Match the production shared.env bucket names.
S3_BUCKET=products
S3_LOGO_BUCKET=logos
S3_PAYMENT_BUCKET=payments

# Kuma push URL; only a verified completed backup should ping it.
KUMA_BACKUP_PUSH_URL=
