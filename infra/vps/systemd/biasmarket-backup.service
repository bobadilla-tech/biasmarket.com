[Unit]
Description=Create and verify one encrypted Bias Market off-box backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/home/deploy/biasmarket/env/backup.env
ExecStartPre=/usr/local/sbin/biasmarket-backup-config-check --check
ExecStart=/usr/local/sbin/biasmarket-backup
TimeoutStartSec=12h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/biasmarket-backup /run/lock
