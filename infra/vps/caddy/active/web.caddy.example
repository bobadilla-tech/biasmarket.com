## Template only — see api.caddy.example for the full explanation. Same
## mechanism, targets web-blue/web-green instead of api-blue/api-green.
reverse_proxy web-blue:3001 {
	health_uri /api/health
	health_interval 10s
	health_timeout 5s
}

