#cloud-config
# Runs ONCE, on the first boot after Terraform (re)installs the VPS.
# Replaces steps 1-4 of the manual fallback in docs/core/provisioning.md. Changing this file changes `user_data`,
# which makes the provider REINSTALL the server.

package_update: true
packages:
  - rsync
  - openssh-server
  - curl
  - ca-certificates
  - sudo
  - ufw

# Host key generated by Terraform (tls_private_key.host) so known_hosts can be
# pinned before the server ever boots. Replaces the freshly generated keys.
ssh_deletekeys: true
ssh_keys:
  ed25519_private: |
    ${indent(4, host_private_key)}
  ed25519_public: ${host_public_key}

users:
  - default
  - name: deploy
    gecos: Bias Market deploy user
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      # Key A: rsync only, confined to /home/deploy/biasmarket/ by rrsync.
      - 'command="/usr/local/bin/rrsync /home/deploy/biasmarket/",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ${deploy_rsync_public_key}'
      # Key B: forced command, only the deploy dispatcher script.
      - 'command="/home/deploy/biasmarket/bin/ssh-deploy-dispatcher.sh",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ${deploy_dispatch_public_key}'

write_files:
  # sshd uses the FIRST value it reads and includes sshd_config.d/*.conf in
  # lexical order, so 10- beats Ubuntu's 50-cloud-init.conf.
  - path: /etc/ssh/sshd_config.d/10-biasmarket-hardening.conf
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
  # Keep every root-executed backup script, its Compose configuration, and
  # systemd units outside the rrsync-writable application tree. Root services
  # must not execute code or YAML replaced by an rsync deployment.
  - path: /usr/local/sbin/biasmarket-backup-setup
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, backup_setup_script)}
  - path: /usr/local/sbin/biasmarket-backup
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, backup_script)}
  - path: /usr/local/sbin/biasmarket-backup-config-check
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, backup_config_check_script)}
  - path: /etc/biasmarket-backup-compose.yml
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_compose)}
  - path: /etc/systemd/system/biasmarket-backup-config.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_config_unit)}
  - path: /etc/systemd/system/biasmarket-backup.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_service_unit)}
  - path: /etc/systemd/system/biasmarket-backup.timer
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_timer_unit)}
  - path: /etc/systemd/system/biasmarket-backup-setup.path
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_setup_path_unit)}
  - path: /etc/systemd/system/biasmarket-backup-setup.service
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, backup_setup_service_unit)}
  # deploy.sh can only invoke this fixed, root-owned preflight helper.
  - path: /etc/sudoers.d/biasmarket-backup-setup
    owner: root:root
    permissions: "0440"
    content: |
      deploy ALL=(root) NOPASSWD: /usr/local/sbin/biasmarket-backup-setup

runcmd:
  # Ubuntu 26.04 ships rrsync in /usr/bin; the authorized_keys lines above (and
  # the docs) use /usr/local/bin.
  - ln -sf /usr/bin/rrsync /usr/local/bin/rrsync
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker deploy
  - systemctl daemon-reload
  - mkdir -p /home/deploy/biasmarket/env /home/deploy/biasmarket/caddy/active /home/deploy/biasmarket/state /home/deploy/biasmarket/releases
  - chown -R deploy:deploy /home/deploy/biasmarket
  - install -d -o root -g root -m 0711 /var/lib/biasmarket-backup
  - install -d -o 10001 -g 10001 -m 0700 /var/lib/biasmarket-backup/stage
  # Firewall: SSH and web only. (Docker publishes only Caddy's 80/443.)
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable
  # 4 GB swap: two app colours briefly run side by side during a cutover.
  - fallocate -l 4G /swapfile
  - chmod 600 /swapfile
  - mkswap /swapfile
  - swapon /swapfile
  - echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - systemctl restart ssh
  - visudo -cf /etc/sudoers.d/biasmarket-backup-setup
