# ============================================================================
# biasmarket-app — Docker environment defaults
# ============================================================================
# Committed with SAFE, WORKING DEV DEFAULTS. Powers the full dev stack out of
# the box (docker-compose.dev.yml loads it directly via env_file).
#
# For production, copy to `.env` (gitignored) in this same directory and
# replace every value with a real secret:
#   cp .env.example .env
#
# Optional `.env.local` (gitignored, dev-only) may sit alongside this file to
# override any value for personal per-developer tweaks. Layered on top of
# this file in docker-compose.dev.yml; not required to exist.
# ============================================================================

COMPOSE_BAKE=true

# ---- PostgreSQL (packages/db, apps/api) ----------------------------------
# Inside the Docker network, containers reach Postgres via the compose
# service name "db", not "localhost". Port still published to the host so
# host-side tools (psql, prisma studio run natively) can connect via
# localhost as before.
POSTGRES_USER=biasmarket
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=biasmarket
DATABASE_URL=postgresql://biasmarket:localdevpassword@db:5432/biasmarket

# ---- Redis (apps/api producer, apps/workers consumer — BullMQ) -----------
# Inside the Docker network, containers reach Redis via the compose service
# name "redis", not "localhost". Port still published to the host so
# redis-cli/RedisInsight can connect via localhost during development.
REDIS_PASSWORD=localdevredispassword
REDIS_URL=redis://:localdevredispassword@redis:6379

# ---- apps/api (NestJS + better-auth) --------------------------------------
PORT=3000
# Prod: https://api.biasmarket.com (own subdomain, see infra/caddy/Caddyfile)
BETTER_AUTH_URL=http://localhost:3000
# Freshly generated dev-only secret — never reuse the old value that used to
# live in apps/api/.env, and rotate again before any real deployment.
BETTER_AUTH_SECRET=848fc28be743f718af16aebd093306bf87898671ad686db26b19973b04ada24b
# Signs the buyer/customer account-confirmation link (30-day token, see
# customer-account-token.ts) — separate from BETTER_AUTH_SECRET on purpose,
# so rotating one doesn't invalidate the other. Prod: rotated by
# `pnpm env:init --prod` same as BETTER_AUTH_SECRET.
CUSTOMER_ACCOUNT_TOKEN_SECRET=d9f1c52e98037c161acaad4ef6a375a7524131183bbd4cada0a383fdf984c66e
# Prod: https://biasmarket.com — used for CORS and the GET / redirect target
WEB_URL=http://localhost:3001

# ---- apps/web (Next.js) ----------------------------------------------------
# Must be reachable from the BROWSER — published host port, never the
# internal docker hostname "api:3000". Prod: https://api.biasmarket.com
# (no /api suffix — the app appends that itself).
NEXT_PUBLIC_API_URL=http://localhost:3000
# Server-side (SSR/Server Component) fetches run inside the "web" container,
# where "localhost" refers to that container, not "api". Use the compose
# service name instead. Not needed in prod — NEXT_PUBLIC_API_URL there is
# already a real, container-reachable domain.
INTERNAL_API_URL=http://api:3000

# ---- Sanity CMS (blog content, external project) ---------------------------
# The blog (app/[locale]/(marketing)/blog) reads published `post` documents
# from the external Sanity project. projectId/dataset are public (client-safe)
# and hardcoded in apps/web/client/sanity.ts — only the webhook secret is an
# actual secret and must be supplied manually here, same as RESEND_API_KEY.
# SANITY_REVALIDATE_SECRET signs the Sanity webhook that hits
# https://biasmarket.com/api/revalidate (sent as the `x-sanity-webhook-secret`
# header). Prod: set manually on the server — real credential, never
# auto-generated.
SANITY_REVALIDATE_SECRET=

# ---- apps/workers -> apps/api internal endpoints --------------------------
# apps/workers reuses INTERNAL_API_URL above (same value, same convention —
# the internal Docker network hostname, never api.biasmarket.com) to reach
# apps/api's /internal/* routes (e.g. the order-expiration sweep). Shared
# secret both apps check via constant-time comparison — the last of three
# defense layers for that path (internal-network-only + Caddy block +
# secret). Prod: rotated by `pnpm env:init --prod` same as
# BETTER_AUTH_SECRET.
INTERNAL_JOBS_SECRET=1f6c7c4c9b2a4e3f8d5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e

# Prod: S3_ENDPOINT stays the internal Docker network name (the minio
# service in docker-compose.yml) — never a public URL.
S3_ENDPOINT=http://minio:9000
# Prod: https://cdn.biasmarket.com (see infra/caddy/Caddyfile) — the value
# returned to clients gets saved verbatim into Product.images/Store.logoUrl,
# so treat it as durable once real uploads exist.
S3_PUBLIC_URL=http://localhost:9000
# Prod: rotated by `pnpm env:init --prod` (scripts/init-env.ts) — never reuse
# these dev-only defaults, they double as the MinIO root credentials in
# docker-compose.yml.
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password123
S3_BUCKET=products
# Separate bucket for store logos, kept apart from product images.
S3_LOGO_BUCKET=logos
# Payment-proof images (bank-transfer/Yape/Plin screenshots) — kept private,
# no anonymous-read policy applied in minio-init. The only way to read one is
# the authenticated GET .../payments/:paymentId/image endpoint.
S3_PAYMENT_BUCKET=payments

# ---- apps/workers (mailer / Resend) ----------------------------------------
# 'file' writes outgoing emails to apps/workers/.mailer-dev/*.html instead of
# sending (dev default, safe — nothing ever leaves the machine). Prod
# forces 'resend' (see scripts/init-env.ts). Read by apps/workers only —
# apps/api enqueues jobs but never touches Resend directly.
MAIL_DRIVER=file
# Only required when MAIL_DRIVER=resend (prod). The file driver — the local
# dev mode — boots fine without either (startup env validation and
# MailerCore both treat them as resend-only). Prod: replace manually on the
# server — real third-party credential, not auto-generated by
# `pnpm env:init --prod`.
RESEND_API_KEY=re_dev_placeholder_not_a_real_key
# biasmarket.com is verified in Resend — safe to use in prod as-is.
RESEND_FROM_EMAIL=no-reply@biasmarket.com

# ---- Monitoring (Uptime Kuma -> apps/api durable incident history) --------
# Shared secret Kuma's webhook notification provider sends back as
# X-Webhook-Secret on POST /api/monitoring/webhook (see
# MonitoringWebhookSecretGuard). Also hand-entered a second time into Kuma's
# own notification-provider config — rotating it is a two-step manual
# process, see docs/core/incident-response.md. Prod: rotated by
# `pnpm env:init --prod` same as BETTER_AUTH_SECRET.
MONITORING_WEBHOOK_SECRET=6b8f1a3e9c2d4f5061728394a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b

# ---- Error tracking (GlitchTip — Sentry-protocol-compatible) --------------
# Optional. Errors still reach stdout/docker logs when unset; set the DSNs to
# also report them to GlitchTip. Three vars because api and web report to
# separate GlitchTip projects and both containers share this env file:
#   SENTRY_DSN              api's project (apps/api/src/common/error-tracking.ts)
#   WEB_SENTRY_DSN          web's server-side project (apps/web/instrumentation.ts)
#   NEXT_PUBLIC_SENTRY_DSN  web's client-side project (inlined at build time —
#                           passed through as a Docker build arg, see
#                           docker-compose.yml / web.Dockerfile)
# Supply DSNs through deployment secrets; never commit project DSNs here.
SENTRY_DSN=
WEB_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
