{
  "expo": {
    "name": "Bias Market",
    "slug": "biasmarket-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/images/icon.png",
    "scheme": "biasmarket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.biasmarket.mobile",
      "associatedDomains": ["applinks:biasmarket.com"]
    },
    "android": {
      "package": "com.biasmarket.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "biasmarket.com",
              "pathAdvancedPattern": "/es/store/[^/]+/product/[^/]+"
            },
            {
              "scheme": "https",
              "host": "biasmarket.com",
              "pathAdvancedPattern": "/en/store/[^/]+/product/[^/]+"
            },
            {
              "scheme": "https",
              "host": "biasmarket.com",
              "pathAdvancedPattern": "/es/store/[^/]+/account/orders/[^/]+"
            },
            {
              "scheme": "https",
              "host": "biasmarket.com",
              "pathAdvancedPattern": "/en/store/[^/]+/account/orders/[^/]+"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
