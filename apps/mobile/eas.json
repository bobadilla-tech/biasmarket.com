{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "environment": "preview",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "preview": {
      "ios": {},
      "android": { "track": "internal" }
    },
    "beta": {
      "ios": {},
      "android": { "track": "internal" }
    },
    "production": {
      "ios": {},
      "android": { "track": "production" }
    }
  }
}
